      "title": "Snaptapp Studio Reimagined"
    },
    "tools": [
      {
        "name": "get_studio_overview",
        "title": "Studio overview",
        "description": "Return a short overview of Snaptapp: what the studio is, when it was founded, and how to reach it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List Snaptapp products with status, platforms, and canonical URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_game_details",
        "title": "Game details",
        "description": "Return full detail for a Snaptapp game: how it plays, modes, player counts, platform status, pricing, and the technology behind it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "game": {
              "description": "Game name, e.g. 'More or Less'. Defaults to the live title.",
              "type": "string",
              "maxLength": 60
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_channels",
        "title": "Contact channels",
        "description": "Return Snaptapp email channels for press, licensing, support, privacy, security, and legal.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_discovery_documents",
        "title": "Discovery documents",
        "description": "List machine-readable discovery URLs on snaptapp.us (API catalog, OpenAPI, MCP, OAuth, skills).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_pages",
        "title": "List site pages",
        "description": "List every public page on snaptapp.us with its path, title, and a summary of what the page covers. Use this to decide which page to read.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_site",
        "title": "Search site pages",
        "description": "Search the studio site's pages by keyword and return the matching pages ranked by relevance, with title, summary, and URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "Words to search for, e.g. 'data deletion' or 'game modes'."
            },
            "limit": {
              "description": "Maximum number of pages to return (default 5).",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_page",
        "title": "Read a site page",
        "description": "Fetch a public page of snaptapp.us and return its readable text, so answers quote the live copy instead of guessing. Use list_pages or search_site to find the path.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^\\/[A-Za-z0-9/_-]*$",
              "description": "Site path, e.g. '/support/' or '/legal/privacy/'."
            },
            "max_characters": {
              "description": "Truncate the returned text at this length (default 8000).",
              "type": "integer",
              "minimum": 500,
              "maximum": 20000
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_site_status",
        "title": "Site status",
        "description": "Check that snaptapp.us is responding by reading its health endpoint, and return the live status payload.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_trivia_examples",
        "title": "Example numerical trivia",
        "description": "Return verified example numerical trivia questions with their real values and units, as published on snaptapp.us. Useful for explaining or demonstrating how More or Less rounds work.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by category, e.g. 'Science & Space'.",
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "description": "Maximum number of examples (default all).",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "summarize_click_insights",
        "title": "Summarize click placements",
        "description": "Admins only. Given a date range and click counts per placement, return an AI summary of trends, the weakest placements, and recommendations.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Range start, YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Range end, YYYY-MM-DD."
            },
            "rows": {
              "minItems": 1,
              "maxItems": 60,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "enum": [
                      "cta_click",
                      "outbound_click"
                    ],
                    "description": "Analytics event name."
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60,
                    "description": "Placement, e.g. 'hero' or 'footer'."
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Clicks in the range."
                  }
                },
                "required": [
                  "event",
                  "location",
                  "count"
                ]
              },
              "description": "Click counts per event and placement."
            },
            "notes": {
              "description": "Extra context for the summary.",
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "start_date",
            "end_date",
            "rows"
          ],
          "additionalProperties": false
        },
        "outputSchema": null,
        "conditional": true
      }
    ]
  }
}
